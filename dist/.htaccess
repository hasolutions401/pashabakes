# Pashabakess — Apache settings (alwaysdata runs Apache + PHP FastCGI)
Options -Indexes
DirectoryIndex index.html index.php

<IfModule mod_mime.c>
  AddType font/woff2 .woff2
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
  # Browsers remember to use HTTPS only (30 days). Raise to 31536000 (1 year) once the final domain is settled.
  Header always set Strict-Transport-Security "max-age=2592000"
  # What pages may load. img-src allows any https image because flavors can use photo links (Admin → Menu).
  # If you add a new outside service (fonts, analytics, ads…), add its address here or the browser blocks it.
  Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data: https:; connect-src 'self'; form-action 'self'; frame-ancestors 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"
</IfModule>

# Browser caching. Pages always check for a newer version; CSS/JS links carry ?v=N (bump it after every
# change, see CLAUDE.md) so they can be kept for 30 days; images for 7 days (add ?v= when replacing one).
<IfModule mod_headers.c>
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.(jpe?g|png|webp|gif|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Never serve hidden files (.git, .env, …)
<FilesMatch "^\.">
  Require all denied
</FilesMatch>

# HTTPS: turn on "Force HTTPS" in alwaysdata → Web → Sites → (site) → SSL.
